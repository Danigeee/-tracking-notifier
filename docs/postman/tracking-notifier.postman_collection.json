{
  "info": {
    "name": "tracking-notifier",
    "description": "Colección para probar tracking-notifier. Variables: baseUrl (servicio), tenant (cliente que hace las peticiones) y guia (número de guía).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tenant",
      "value": "cliente-demo"
    },
    {
      "key": "guia",
      "value": "GUIA-100"
    }
  ],
  "item": [
    {
      "name": "Guías",
      "item": [
        {
          "name": "Registrar evento - CREADA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"estado\": \"CREADA\",\n  \"fechaEvento\": \"{{$isoTimestamp}}\",\n  \"observacion\": \"Recibida en bodega\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Registrar evento - EN_RUTA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"estado\": \"EN_RUTA\",\n  \"fechaEvento\": \"{{$isoTimestamp}}\",\n  \"observacion\": \"Salió de la bodega\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Registrar evento - ENTREGADA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"estado\": \"ENTREGADA\",\n  \"fechaEvento\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Registrar evento - DEVUELTA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"estado\": \"DEVUELTA\",\n  \"fechaEvento\": \"{{$isoTimestamp}}\",\n  \"observacion\": \"Dirección incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Registrar evento - duplicado (eventId fijo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n  \"estado\": \"CREADA\",\n  \"fechaEvento\": \"2026-10-24T10:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Consultar guía",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/guias/{{guia}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guias",
                "{{guia}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhook",
      "item": [
        {
          "name": "Configurar webhook",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://localhost:4000/hook\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Consultar webhook",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Rotar secreto del webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhook/secreto",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "secreto"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notificaciones",
      "item": [
        {
          "name": "Consultar notificaciones (todas)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notificaciones"
              ]
            }
          }
        },
        {
          "name": "Consultar notificaciones - PENDIENTE",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones?estado=PENDIENTE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notificaciones"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "PENDIENTE"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar notificaciones - ENVIADA",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones?estado=ENVIADA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notificaciones"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "ENVIADA"
                }
              ]
            }
          }
        },
        {
          "name": "Consultar notificaciones - FALLIDA",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones?estado=FALLIDA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notificaciones"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "FALLIDA"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
