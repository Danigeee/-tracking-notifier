{
  "name": "tracking-notifier",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danigeee/-tracking-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/Danigeee/-tracking-notifier/issues"
  },
  "homepage": "https://github.com/Danigeee/-tracking-notifier#readme",
  "description": "Microservicio que recibe cambios de estado de guías de envío y notifica a cada cliente por webhook",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
