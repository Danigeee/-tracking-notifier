# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# Puerto HTTP del servicio
PORT=3000

# Cadena de conexión a PostgreSQL (la del contenedor de docker compose escucha en 5433 desde tu máquina)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracking_notifier

# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info

# Cada cuántos milisegundos el worker busca notificaciones pendientes
WORKER_INTERVAL_MS=2000

# Cuántas notificaciones procesa el worker por pasada
WORKER_BATCH_SIZE=10

# Tiempo máximo de espera (ms) de la respuesta del webhook del cliente
WEBHOOK_TIMEOUT_MS=5000

# Segundos de espera entre los intentos de entrega de un aviso (hasta 4 valores = hasta 5 intentos).
# Con "1,1,1,1" un aviso fallido se ve en segundos, útil para una demostración.
REINTENTO_ESPERAS_SEGUNDOS=10,60,300,1800

# (Opcional) Conexión de administración para las pruebas de integración. Por defecto usa el
# Postgres del docker compose. Las pruebas crean y borran su propia base temporal.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ---------------------------------------------------------------------------
# Variables opcionales de `docker compose up` (todas tienen valor por defecto)
# ---------------------------------------------------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=tracking_notifier
#
# Puertos en tu máquina, por si alguno está ocupado
# APP_PORT=3000
# WEBHOOK_PORT=4000
# DB_PORT=5433
#
# Webhook de prueba: con el secreto que devuelve PUT /webhook verifica la firma de los avisos
# WEBHOOK_SECRET=
# Simulaciones: código de respuesta, fallar los N primeros intentos de cada evento, demora en ms
# WEBHOOK_STATUS=200
# WEBHOOK_FAIL_FIRST=0
# WEBHOOK_DELAY_MS=0
