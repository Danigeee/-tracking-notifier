# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# Puerto HTTP del servicio
PORT=3000

# Cadena de conexión a PostgreSQL (la del contenedor de docker compose escucha en 5433 desde tu máquina)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracking_notifier

# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info
